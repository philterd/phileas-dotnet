<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <!-- Matches the single TFM of the service under test. -->
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <IsPackable>false</IsPackable>
    </PropertyGroup>
    <ItemGroup>
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.9.0" />
        <PackageReference Include="xunit" Version="2.7.0" />
        <PackageReference Include="xunit.runner.visualstudio" Version="2.5.7">
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
            <PrivateAssets>all</PrivateAssets>
        </PackageReference>
        <!-- Lets a fact skip at runtime (e.g. when Docker is unavailable) instead of failing. -->
        <PackageReference Include="Xunit.SkippableFact" Version="1.4.13" />
        <!-- Hosts the Phileas.Rest app in-process for end-to-end HTTP tests. -->
        <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.0" />
        <!-- Spins up real MongoDB + Valkey backends in containers. -->
        <PackageReference Include="Testcontainers" Version="4.1.0" />
        <PackageReference Include="Testcontainers.MongoDb" Version="4.1.0" />
        <!-- Builds the .docx fixture the redaction test uploads. -->
        <PackageReference Include="DocumentFormat.OpenXml" Version="3.5.1" />
    </ItemGroup>
    <ItemGroup>
        <ProjectReference Include="../../src/Phileas.Rest/Phileas.Rest.csproj" />
    </ItemGroup>
</Project>
