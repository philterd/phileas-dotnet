<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <IsPackable>false</IsPackable>
    </PropertyGroup>
    <ItemGroup>
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.9.0"/>
        <PackageReference Include="xunit" Version="2.7.0"/>
        <PackageReference Include="xunit.runner.visualstudio" Version="2.5.7">
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
            <PrivateAssets>all</PrivateAssets>
        </PackageReference>
        <!-- SkiaSharp native binaries for headless Linux (no system fontconfig dependency), so the
             PDF rasterization/drawing tests can run in CI and containers. -->
        <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="3.119.4" />
    </ItemGroup>
    <ItemGroup>
        <ProjectReference Include="../../src/Phileas/Phileas.csproj"/>
    </ItemGroup>
    <ItemGroup>
        <!-- Shared test documents (copied from the Java test resources). -->
        <Content Include="Resources\*.txt" CopyToOutputDirectory="PreserveNewest"/>
        <Content Include="Resources\*.pdf" CopyToOutputDirectory="PreserveNewest"/>
        <!-- GLiNER SentencePiece tokenizer parity fixtures: the spm.model and its golden token ids.
             The generator script stays source-only (not copied to the output). -->
        <Content Include="Resources\Gliner\spm.model" CopyToOutputDirectory="PreserveNewest"/>
        <Content Include="Resources\Gliner\tokenizer_parity.json" CopyToOutputDirectory="PreserveNewest"/>
    </ItemGroup>
</Project>
