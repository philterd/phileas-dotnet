<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <IsPackable>false</IsPackable>
    </PropertyGroup>
    <ItemGroup>
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.9.0"/>
        <PackageReference Include="xunit" Version="2.7.0"/>
        <PackageReference Include="xunit.runner.visualstudio" Version="2.5.7">
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
            <PrivateAssets>all</PrivateAssets>
        </PackageReference>
        <!-- SkiaSharp native binaries for headless Linux (no system fontconfig dependency), so the
             PDF rasterization/drawing tests can run in CI and containers. -->
        <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="3.119.4" />
        <!-- Office redaction tests build .docx/.xlsx fixtures directly with the Open XML SDK. -->
        <PackageReference Include="DocumentFormat.OpenXml" Version="3.5.1" />
    </ItemGroup>
    <ItemGroup>
        <ProjectReference Include="../../src/Phileas/Phileas.csproj"/>
    </ItemGroup>
    <ItemGroup>
        <!-- Shared test documents (copied from the Java test resources). -->
        <Content Include="Resources\*.txt" CopyToOutputDirectory="PreserveNewest"/>
        <Content Include="Resources\*.pdf" CopyToOutputDirectory="PreserveNewest"/>
        <!-- Vendored compiled-policy fixtures (e.g. PhiSQL output) for policy deserialization tests. -->
        <Content Include="Resources\Policies\*.json" CopyToOutputDirectory="PreserveNewest"/>
        <!-- GLiNER test fixtures. spm.model + tokenizer_parity.json drive the tokenizer parity test;
             model.onnx + gliner_config.json + spm.model together form a self-contained GLiNER model
             directory for the synthetic end-to-end inference test. Generator scripts stay source-only. -->
        <Content Include="Resources\Gliner\spm.model" CopyToOutputDirectory="PreserveNewest"/>
        <Content Include="Resources\Gliner\tokenizer_parity.json" CopyToOutputDirectory="PreserveNewest"/>
        <Content Include="Resources\Gliner\model.onnx" CopyToOutputDirectory="PreserveNewest"/>
        <Content Include="Resources\Gliner\gliner_config.json" CopyToOutputDirectory="PreserveNewest"/>
    </ItemGroup>
</Project>
