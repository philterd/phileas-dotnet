<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <RootNamespace>Phileas</RootNamespace>
        <!-- NuGet package metadata -->
        <PackageId>Phileas</PackageId>
        <Version>1.0.0</Version>
        <Authors>Philterd, LLC</Authors>
        <Company>Philterd, LLC</Company>
        <Description>A .NET library for detecting and redacting Personally Identifiable Information (PII) from text using configurable, policy-based filters.</Description>
        <PackageTags>pii;redaction;privacy;nlp;phileas;philter</PackageTags>
        <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
        <PackageProjectUrl>https://github.com/philterd/phileas-net</PackageProjectUrl>
        <RepositoryUrl>https://github.com/philterd/phileas-net</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <Copyright>Copyright 2026 Philterd, LLC</Copyright>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <Title>Phileas</Title>
        <PackageLicenseUrl>https://github.com/philterd/phileas-net/blob/main/LICENSE</PackageLicenseUrl>
        <PackageRequireLicenseAcceptance>true</PackageRequireLicenseAcceptance>
    </PropertyGroup>
    <ItemGroup>
        <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.24.2" />
        <PackageReference Include="JsonSchema.Net" Version="7.0.4" />
        <!-- PDF redaction: PdfPig extracts text with per-glyph coordinates; PDFtoImage (PDFium)
             rasterizes pages; SkiaSharp draws redaction rectangles, encodes JPEG/PNG, and assembles
             the image-only output PDF. -->
        <PackageReference Include="PdfPig" Version="0.1.14" />
        <PackageReference Include="PDFtoImage" Version="5.2.1" />
        <PackageReference Include="SkiaSharp" Version="3.119.4" />
    </ItemGroup>
    <ItemGroup>
        <!-- PhiSQL .NET reference library. Not yet on NuGet; referenced from the
             sibling phisql checkout. Provides the PhiSQL compiler and the canonical
             redaction policy schema used for all policy operations. -->
        <ProjectReference Include="../../../phisql/reference/dotnet/PhiSql/PhiSql.csproj" />
    </ItemGroup>
    <ItemGroup>
        <None Include="..\..\README.md" Pack="true" PackagePath="\" />
        <None Include="..\..\NOTICE" Pack="true" PackagePath="\" />
    </ItemGroup>
    <ItemGroup>
        <!-- Fake-data dictionaries used by the data generators / anonymization services, embedded
             into the assembly (the .NET analog of the Java classpath resources). -->
        <EmbeddedResource Include="Data\Resources\*.txt" />
        <EmbeddedResource Include="Data\Resources\*.csv" />
    </ItemGroup>
    <ItemGroup>
      <Folder Include="Filters\AI\" />
    </ItemGroup>
</Project>
