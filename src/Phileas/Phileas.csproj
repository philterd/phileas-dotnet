<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <RootNamespace>Phileas</RootNamespace>
        <!-- NuGet package metadata. PackageId follows the Philterd.* convention
             (as with Philterd.PhiSql); the assembly name and namespace stay
             Phileas, so the public API (using Phileas) is unchanged. -->
        <PackageId>Philterd.Phileas</PackageId>
        <Version>1.2.0</Version>
        <Authors>Philterd, LLC</Authors>
        <Company>Philterd, LLC</Company>
        <Description>A .NET library for detecting and redacting Personally Identifiable Information (PII) from text using configurable, policy-based filters.</Description>
        <PackageTags>pii;redaction;privacy;nlp;phileas;philter</PackageTags>
        <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
        <PackageProjectUrl>https://www.github.com/philterd/phileas-dotnet</PackageProjectUrl>
        <RepositoryUrl>https://www.github.com/philterd/phileas-dotnet</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <Copyright>Copyright 2026 Philterd, LLC</Copyright>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <Title>Phileas</Title>
        <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
        <!-- Ship a symbols package (.snupkg) and enable SourceLink so consumers can step into
             Phileas source while debugging. SourceLink for GitHub is bundled with the .NET SDK
             (8.0.100+), so no PackageReference is needed; these properties turn it on and embed
             the repository URL and any untracked sources into the symbols. -->
        <IncludeSymbols>true</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>
        <PublishRepositoryUrl>true</PublishRepositoryUrl>
        <EmbedUntrackedSources>true</EmbedUntrackedSources>
        <!-- Deterministic, reproducible packages when building on CI. -->
        <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
    </PropertyGroup>
    <ItemGroup>
        <!-- Expose internal GLiNER pipeline stages (word split, input framing, decode) to the test project so they
             can be unit-tested without a model. -->
        <InternalsVisibleTo Include="Phileas.Tests" />
    </ItemGroup>
    <ItemGroup>
        <PackageReference Include="JsonSchema.Net" Version="7.0.4" />
        <!-- Local GLiNER inference (PhEyeFilter local mode): OnnxRuntime runs the exported model in-process;
             Microsoft.ML.Tokenizers provides the SentencePiece tokenizer that reproduces the deberta-v3 ids. -->
        <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.26.0" />
        <PackageReference Include="Microsoft.ML.Tokenizers" Version="2.0.0" />
        <!-- PDF redaction: PdfPig extracts text with per-glyph coordinates; PDFtoImage (PDFium)
             rasterizes pages; SkiaSharp draws redaction rectangles, encodes JPEG/PNG, and assembles
             the image-only output PDF. -->
        <PackageReference Include="PdfPig" Version="0.1.14" />
        <PackageReference Include="PDFtoImage" Version="5.2.1" />
        <PackageReference Include="SkiaSharp" Version="3.119.4" />
    </ItemGroup>
    <ItemGroup>
        <!-- PhiSQL .NET reference library (Philterd.PhiSql on NuGet). Provides the PhiSQL
             compiler and the canonical redaction policy schema used for all policy operations. -->
        <PackageReference Include="Philterd.PhiSql" Version="1.1.1" />
    </ItemGroup>
    <ItemGroup>
        <None Include="..\..\README.md" Pack="true" PackagePath="\" />
        <None Include="..\..\NOTICE" Pack="true" PackagePath="\" />
    </ItemGroup>
    <ItemGroup>
        <!-- Fake-data dictionaries used by the data generators / anonymization services, embedded
             into the assembly (the .NET analog of the Java classpath resources). -->
        <EmbeddedResource Include="Data\Resources\*.txt" />
        <EmbeddedResource Include="Data\Resources\*.csv" />
    </ItemGroup>
    <ItemGroup>
      <Folder Include="Filters\AI\" />
    </ItemGroup>
</Project>
